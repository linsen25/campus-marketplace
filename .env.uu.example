# Unified UU local configuration. Copy to .env.uu.local and fill only from
# the Usual & Unusual Supabase project dashboard or approved secret manager.
# Do not commit .env.uu.local.
APP_ENV=uu
NEXT_PUBLIC_SUPABASE_URL=https://uqhyjpjiznpgomuizfqe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# This launcher intentionally keeps every Stripe execution path unavailable.
# Leave these values false until a separately approved Test-mode payment run.
STRIPE_PROVIDER_ENABLED=false
STRIPE_ORDER_PAYMENTS_ENABLED=false
STRIPE_ORDER_REFUNDS_ENABLED=false
STRIPE_ORDER_TRANSFERS_ENABLED=false
STRIPE_ORDER_TRANSFERS_CREATE_APPROVED=false
STRIPE_APPLICATION_ORIGIN=http://localhost:3000

# Optional integrations stay unconfigured in the initial unified environment.
GOOGLE_PLACES_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
NOTIFICATION_APP_ORIGIN=
UWO_VERIFICATION_CODE_SECRET=
UWO_VERIFICATION_EMAIL_WEBHOOK_URL=
UWO_VERIFICATION_EMAIL_WEBHOOK_SECRET=
