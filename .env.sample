# Google Analytics (to be replaced with yours)
NEXT_PUBLIC_UA_ID=UA-32446386-47

# Supabase marketplace (public project configuration, never use a service-role key)
# Server-only Messages designation: staging or production; blank fails closed.
APP_ENV=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# UWO Email Verified (server-only; leave unset until a real mail adapter is configured).
UWO_VERIFICATION_CODE_SECRET=
UWO_VERIFICATION_EMAIL_WEBHOOK_URL=

# Stripe Phase 1B: account setup only, staging/test mode only. No real values here.
STRIPE_PROVIDER_ENABLED=false
STRIPE_API_VERSION=2026-09-30.endive
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_APPLICATION_ORIGIN=
# Optional verified public staging deployment, HTTPS origin only (never localhost).
# Leave empty until /seller/[id] is deployed and publicly accessible without auth.
UU_PUBLIC_STAGING_ORIGIN=
# Separate signing secrets for platform snapshot / connected snapshot / v2 thin events.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_ACCOUNT_WEBHOOK_SECRET=
# Dedicated >=32-character server-only scheduler credential.
STRIPE_WORKER_SECRET=
# Independent Order Payment reconciliation gate. A scheduled Worker must not
# claim Payment events while the Order Payment runtime is disabled.
STRIPE_ORDER_PAYMENTS_ENABLED=false
# Authorized Buyer Refund executor/reconciliation. No browser authority.
STRIPE_ORDER_REFUNDS_ENABLED=false
# Seller Connected Account Transfer executor/reconciliation. Both gates are
# required; CREATE_APPROVED stays false until the commercial model is approved.
STRIPE_ORDER_TRANSFERS_ENABLED=false
STRIPE_ORDER_TRANSFERS_CREATE_APPROVED=false
# B24-C read-only connected-account Payout observation. No Payout creation.
STRIPE_CONNECTED_PAYOUT_OBSERVATION_ENABLED=false
# B25-A read-only Stripe payment-dispute observation. No dispute actions.
STRIPE_ORDER_DISPUTE_OBSERVATION_ENABLED=false
# B25-C recovery run fencing/audit. This grants no financial create authority.
STRIPE_OPERATIONAL_RECOVERY_ENABLED=false

# B26-A presentation gate only. The private database admission row remains the
# authoritative default-closed boundary for new Shop transactions.
NEXT_PUBLIC_SHOP_TRANSACTIONS_ENABLED=false
# B26-B server-only bounded lifecycle reconciliation. No scheduler is installed.
SHOP_SUSPENSION_LIFECYCLE_ENABLED=false
